          "range": true,
          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "sum(rate(process_cpu_seconds_total{service_name=~\"$service_name\"}[5m]))",
          "legendFormat": "cpu",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "Saturation (Memory / CPU)",
      "type": "timeseries"
    }
