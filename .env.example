# Container images (pin or override as needed per environment).
LGTM_IMAGE=grafana/otel-lgtm:latest
OTEL_DEMO_IMAGE=ghcr.io/open-telemetry/demo:latest

# Host port mappings for local access.
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
LOKI_PORT=3100
TEMPO_PORT=3200
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
DEMO_UI_PORT=8080

# Grafana credentials (override in local .env; never commit real secrets).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Demo exporter wiring (must remain OTLP/HTTP to LGTM).
OTEL_EXPORTER_OTLP_ENDPOINT=http://grafana-lgtm:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# Slack webhook URL placeholder for alert notifications.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE/ME

# Optional retention tuning for Prometheus data in LGTM.
PROMETHEUS_RETENTION=7d
